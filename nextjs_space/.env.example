DATABASE_URL="postgresql://borsabi:borsabi@localhost:5432/borsabi?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# AI_PROVIDER: groq or abacus; omit to use Groq when its key is present.
AI_PROVIDER=""
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
ABACUSAI_API_KEY=""
# Optional development seed; never use an existing production account.
SEED_EMAIL=""
SEED_PASSWORD=""
# Public Android app identity. Use the Play APP SIGNING certificate SHA-256,
# not the upload-key fingerprint. Multiple certificates may be comma-separated.
# Keep empty until the existing Play package identity is confirmed.
ANDROID_APPLICATION_ID=""
ANDROID_SHA256_CERT_FINGERPRINTS=""
